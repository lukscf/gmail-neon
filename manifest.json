{
  "manifest_version": 3,
  "name": "GM Neon para Gmail",
  "version": "1.4.0",
  "description": "Tema neon, fundos animados e hover 3D para Gmail. Inclui atalhos visuais e opção de marcar a caixa como lida.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/mail/*"
  ],
  "action": {
    "default_title": "GM Neon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/mail/*"
      ],
      "js": [
        "bullet-fx.js",
        "content.js"
      ],
      "css": [
        "theme.css",
        "effects.css",
        "ui.css",
        "bullet.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
